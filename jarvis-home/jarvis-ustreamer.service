[Unit]
Description=Jarvis ustreamer USB webcam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis
# Wait for the USB camera to enumerate (up to 30s) before starting.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/video0 ] && exit 0; sleep 1; done; echo "no /dev/video0" >&2; exit 1'
# --persistent rides over this cheap Jieli (JLDV/AC54) cam's frame drops and the
# "select() Inappropriate ioctl" reopen loop that wedged go2rtc/ffmpeg.
# Bound to all interfaces on :20011 so the HA VM and the bot container can reach it.
ExecStart=/usr/bin/ustreamer --device=/dev/video0 --format=MJPEG --resolution=640x480 --desired-fps=15 --persistent --drop-same-frames=30 --host=0.0.0.0 --port=20011
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
